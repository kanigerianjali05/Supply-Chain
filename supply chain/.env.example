.env.example
# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENV=development

# ML Model Configuration
MODEL_DEMAND_ACCURACY=0.91
MODEL_SUPPLIER_THRESHOLD=0.7
MODEL_ROUTE_THRESHOLD=0.5

# Data Configuration
DATA_RETENTION_DAYS=90
BACKUP_ENABLED=True
